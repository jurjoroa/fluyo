            "y": 410,
            "w": 560,
            "h": 150,
            "label": "4. [library / documents / stacks]\nUser opens the document from a card, row, Stacks location,\nhistory node, or search result",
            "color": "#4c8dff",
            "fill": null,
            "border": "solid",
