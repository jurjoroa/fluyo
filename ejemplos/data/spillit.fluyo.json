            "x": 910,
            "y": 410,
            "w": 560,
            "h": 150,
            "label": "4. [reader]\nDefault-on autosave waits for a quiet interval and coalesces\npending changes; the user can turn it off or press\nSave/Cmd-or-Ctrl+S immediately",
            "color": "#7aa2ff",
            "fill": null,
            "border": "solid",
            "lblPos": "center",
