            "y": 180,
            "w": 560,
            "h": 150,
            "label": "2. [server]\nEvery advertised extension is checked against the allowlist\nand, where defined, its content signature/package structure\nbefore bytes move into storage; malformed or disguised files\nfail without a partial row",
            "color": "#46a758",
            "fill": null,
            "border": "solid",
